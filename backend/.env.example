# Civic AI - Backend Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Google Gemini AI Configuration
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Set to 'true' to use the offline mock analyzer (no API key required, zero quota consumed)
# Set to 'false' to use live Google Gemini multimodal vision & generation
AI_MOCK_MODE=true

# Database Configuration (SQLite by default for MVP)
DATABASE_URL=sqlite:///./civic_ai.db

# File Upload Security Settings
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# Security & JWT Authentication
# Generate a secret using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_characters_long
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# CORS Origin (allowed frontend URL)
FRONTEND_ORIGIN=http://localhost:5173

# Application Environment (development / production)
ENVIRONMENT=development
PORT=8000
