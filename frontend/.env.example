# Civic AI - Frontend Environment Configuration Template
# Copy this file to .env

# Backend API Base URL (leave empty in production Docker when frontend is served from same origin)
VITE_API_BASE_URL=http://localhost:8000/api

# OpenStreetMap Geocoding & Tile Configuration
VITE_MAP_DEFAULT_LAT=12.9716
VITE_MAP_DEFAULT_LNG=77.5946
VITE_MAP_DEFAULT_ZOOM=13
